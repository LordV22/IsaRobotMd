# Segredos: configure em Railway Variables ou em .env local privado; nunca commite valores reais.
OWNER_NUMBER=55DDDNUMERO
WHATSAPP_PHONE=55DDDNUMERO
AUTH_DIR=/app/auth_info_baileys

# Modo inicial: self. O Criador pode alternar com /public e /self.
BOT_MODE=self

# API de pesquisa Brave: ativa /google e /gimagem via busca oficial.
# Consulte preço/conta antes de ativar; o código limita a 900 chamadas/mês.
BRAVE_API_KEY=
BRAVE_MONTHLY_LIMIT=900

# YouTube Data API v3: pesquisa retorna metadados e links para assistir; sem download.
# Cota padrão de segurança local: 30 chamadas/dia (Google costuma dar 100 chamadas search/dia).
YOUTUBE_API_KEY=
YOUTUBE_DAILY_LIMIT=30

# Pinterest: somente app OAuth aprovado para endpoint beta; nunca scraping.
PINTEREST_ACCESS_TOKEN=
PINTEREST_DAILY_LIMIT=20

# Apenas mantenha ferramentas locais ffmpeg ligadas depois de instalar o pacote no runtime.
MEDIA_TOOLS_ENABLED=true
